# Contact form service key (Web3Forms)
# Get your key from https://web3forms.com/
# Without a key, the form falls back to the visitor's email client using
# the address in src/data/profile.ts. With neither, the form is hidden.
NEXT_PUBLIC_FORM_ACCESS_KEY=YOUR_ACCESS_KEY_HERE

# Site URL (used for sitemap and OG metadata)
NEXT_PUBLIC_SITE_URL=https://amalbakhouya.dev
